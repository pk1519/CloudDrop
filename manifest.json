{
  "manifest_version": 3,
  "name": "Drive Download Manager",
  "version": "1.0.0",
  "description": "Automatically save downloads to Google Drive with folder management",
  
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "identity",
    "activeTab"
  ],
  
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://*/*",
    "http://*/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drive Download Manager"
  },
  
  "oauth2": {
    "client_id": "22249244365-adgllinlr5f25t8lunqs7gbqibh0qhi2.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/drive"
    ]
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}